  "clarify": {
    "questions": [
      "あなたの立場はどれですか: 雇用される側 / 事業者 / 消費者 / 借主 / その他",
      "相手方は誰ですか (会社、大家、取引先、個人など)",
      "何を実現したいですか: 予防 (契約前の確認) / 交渉 / 紛争の解決 / 文書作成 / 調査",
      "期限や届いている書類はありますか"
    ]
  }
}
