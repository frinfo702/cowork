  "rules": [
    {
      "id": "deadline-urgent",
      "title": "期限・時効の緊急確認",
      "override": true,
      "priority": 100,
      "keywords": {
        "strong": [
          "時効", "期限が明日", "期限が今日", "昨日解雇", "支払督促",
